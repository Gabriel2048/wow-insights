# Copy to .env and fill in. .env is gitignored; never commit real values.
# Register a client at https://www.warcraftlogs.com/api/clients/
#
# The client credentials flow reads public reports only. Private reports would
# need the authorization code flow against /api/v2/user instead.
WARCRAFTLOGS_CLIENT_ID=
WARCRAFTLOGS_CLIENT_SECRET=

# Optional. The model that words the findings on the coaching page. Without it
# every finding still appears, in the analyser's own sentences — so this buys
# better writing, not more analysis. Get one at https://console.anthropic.com/
# ANTHROPIC_API_KEY=

# Optional. Cloud Run sets this; 8080 when unset.
# PORT=8080
# Optional. When set, each request's Cloud Trace id is logged in the form
# Cloud Logging groups by. Harmless when unset.
# GOOGLE_CLOUD_PROJECT=
